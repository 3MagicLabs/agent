# Copy to .env and fill in what you have. Nothing here is committed.
# `agent doctor` reports which of these are set.

# --- Model provider: at least one is required. First match wins. ---
# Order is anthropic > groq > openai > huggingface, so a stray ANTHROPIC_API_KEY
# takes precedence over the rest. Set LLM_PROVIDER to override that explicitly
# (anthropic|groq|openai|huggingface). Named but keyless resolves to no provider
# rather than silently using another.
# LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
HF_TOKEN=

# Optional model overrides.
# ANTHROPIC_MODEL=claude-sonnet-5         # temperature is rejected (400) on this model
# GROQ_MODEL=openai/gpt-oss-120b          # the llama family has been retired by Groq
# OPENAI_MODEL=gpt-4o-mini
# HUGGINGFACE_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct

# --- Tools: optional, each degrades gracefully when absent ---
TAVILY_API_KEY=          # web_search
E2B_API_KEY=             # python_repl sandbox

# --- Observability: optional ---
LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=3magic-agent

# --- Budgets (defaults shown) ---
# MAX_SUPERVISOR_STEPS=4
# MAX_WEB_ITERATIONS=3
# MAX_CODE_ITERATIONS=3
# PER_QUESTION_TIMEOUT_S=180
# TOTAL_BUDGET_S=2400
# MAX_SCRAPE_CHARS=6000
# LLM_TIMEOUT_S=60
# LLM_MAX_RETRIES=2
# LOG_LEVEL=INFO
